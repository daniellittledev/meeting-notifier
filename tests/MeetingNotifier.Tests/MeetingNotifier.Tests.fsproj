<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    F# cares about compile order. Pull the platform-agnostic source files
    from the main project as source-linked files so their logic can be
    tested without bringing in the Windows-only TFM of the app.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\MeetingNotifier\Domain.fs"
             Link="_src\Domain.fs" />
    <Compile Include="..\..\src\MeetingNotifier\Config.fs"
             Link="_src\Config.fs" />
    <Compile Include="..\..\src\MeetingNotifier\EmailRules.fs"
             Link="_src\EmailRules.fs" />
    <Compile Include="..\..\src\MeetingNotifier\EmailStore.fs"
             Link="_src\EmailStore.fs" />
    <Compile Include="..\..\src\MeetingNotifier\GraphParsing.fs"
             Link="_src\GraphParsing.fs" />
    <Compile Include="..\..\src\MeetingNotifier\AlertEngine.fs"
             Link="_src\AlertEngine.fs" />
    <Compile Include="..\..\src\MeetingNotifier\ReminderList.fs"
             Link="_src\ReminderList.fs" />
    <Compile Include="AlertEngineTests.fs" />
    <Compile Include="ConfigTests.fs" />
    <Compile Include="EmailRulesTests.fs" />
    <Compile Include="EmailStoreTests.fs" />
    <Compile Include="GraphParsingTests.fs" />
    <Compile Include="ReminderListTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FsUnit.xUnit" Version="6.0.0" />
    <PackageReference Include="FSharp.JsonSerializer" Version="0.0.3" />
  </ItemGroup>

</Project>
