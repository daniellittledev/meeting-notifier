<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <!-- Flat, theme-driven button so "Dismiss all" matches the window
         instead of falling back to the default light WPF chrome. -->
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background"
                        Value="{DynamicResource ButtonHoverBg}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <!-- Each section caps itself at a few rows (MaxHeight set in code) and
       scrolls on its own; a section hides when it has no rows. -->
  <StackPanel Grid.Row="0" x:Name="MeetingsHeader" Orientation="Horizontal"
              Margin="16,10,16,0">
    <TextBlock Text="MEETINGS" FontSize="12" FontWeight="SemiBold"
               Foreground="{DynamicResource SubtleBrush}"
               VerticalAlignment="Center" />
    <Border Background="{DynamicResource ButtonBg}" CornerRadius="9"
            Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center">
      <TextBlock x:Name="MeetingsCount" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" />
    </Border>
  </StackPanel>
  <ScrollViewer Grid.Row="1" x:Name="MeetingsScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="MeetingsPanel" Margin="0,0,0,8" />
  </ScrollViewer>
  <StackPanel Grid.Row="2" x:Name="EmailsHeader" Orientation="Horizontal"
              Margin="16,10,16,0">
    <TextBlock Text="EMAILS" FontSize="12" FontWeight="SemiBold"
               Foreground="{DynamicResource SubtleBrush}"
               VerticalAlignment="Center" />
    <Border Background="{DynamicResource ButtonBg}" CornerRadius="9"
            Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center">
      <TextBlock x:Name="EmailsCount" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" />
    </Border>
  </StackPanel>
  <ScrollViewer Grid.Row="3" x:Name="EmailsScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="EmailsPanel" Margin="0,0,0,8" />
  </ScrollViewer>
  <Border Grid.Row="4" Background="{DynamicResource HeaderBg}" Padding="10,8">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="SnoozeAllButton" Content="Snooze all"
              Margin="0,0,8,0" Style="{StaticResource FlatButton}" />
      <Button x:Name="DismissAllButton" Content="Dismiss all"
              Style="{StaticResource FlatButton}" />
    </StackPanel>
  </Border>
</Grid>
