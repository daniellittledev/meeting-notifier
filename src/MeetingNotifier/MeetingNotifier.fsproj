<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <RootNamespace>MeetingNotifier</RootNamespace>
    <AssemblyName>MeetingNotifier</AssemblyName>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <!-- Baseline version for local/dev builds; releases are versioned from
         the git tag by the release workflow. -->
    <Version>0.1.0</Version>
    <!-- Keep a single-file deployable exe for the installer path -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="GraphParsing.fs" />
    <Compile Include="GraphClient.fs" />
    <Compile Include="AlertEngine.fs" />
    <Compile Include="AumidRegistration.fs" />
    <Compile Include="Notifications.fs" />
    <Compile Include="Startup.fs" />
    <Compile Include="Updater.fs" />
    <Compile Include="TrayApp.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="alert.wav" />
    <Content Include="appicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.66.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.3.13" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
